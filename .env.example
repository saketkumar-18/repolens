# --- LLM provider (OpenAI-compatible API) ---
# RepoLens works with any OpenAI-compatible endpoint: OpenRouter, OpenAI, Groq, Ollama, vLLM...
# Default: OpenRouter free models.
OPENROUTER_API_KEY=sk-or-...
# Optional overrides:
# REPOLENS_API_KEY=            # takes precedence over OPENROUTER_API_KEY / OPENAI_API_KEY
# REPOLENS_BASE_URL=https://openrouter.ai/api/v1
# REPOLENS_MODELS=minimax/minimax-m3:free,z-ai/glm-5.2:free

# --- GitHub ---
# Needed for private repos and for posting reviews (--post).
# Fine-grained or classic PAT with: repo (read PR diffs, write reviews).
GITHUB_TOKEN=ghp_...

# --- Tuning (optional) ---
# REPOLENS_CONTEXT_BUDGET=60000   # chars of repo context per review
# REPOLENS_MAX_FILES=10           # max files reviewed by the LLM per PR
